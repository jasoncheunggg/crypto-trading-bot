# Copy to .env and fill in. .env is gitignored.

# Alchemy - detection (all chains share one key)
ALCHEMY_API_KEY=

# GMGN - execution.
# The CLI already stores these in ~/.config/gmgn/.env (chmod 600).
# Only set them here if the bot reads them directly instead of via the CLI.
GMGN_API_KEY=
GMGN_PRIVATE_KEY=

# Required for headless swap execution. Set deliberately - it is the
# out-of-band human authorization the CLI's confirmation gate depends on.
GMGN_ALLOW_AUTOMATED_TRADES=0

# The trading wallet address (must match the wallet bound to your GMGN API key)
WALLET_ADDRESS=
