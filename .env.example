# Copy to .env and fill in. .env is gitignored and must never be committed.

# ─── required ──────────────────────────────────────────────────────────────

# Alchemy. Detection (websocket subscription to transfers), all chain reads, and
# historical price reconstruction. One key serves every chain.
ALCHEMY_API_KEY=

# 0x Swap API v2. Quotes and the unsigned calldata every swap is built from.
ZEROX_API_KEY=

# The trading wallet's private key, 0x-prefixed, 32 bytes.
#
# THE BOT SIGNS WITH THIS. It is the whole point of v2.0 — no third party can move
# the funds, and no third party's outage can strand a position. It also means a
# mistake here is irreversible. Use a wallet funded only with what you intend to
# trade, never a personal one.
BOT_PRIVATE_KEY=

# The address the key above derives. Checked against the key at startup: if they
# disagree the bot refuses to sign, rather than sending trades to a wallet it
# cannot spend from.
BOT_WALLET_ADDRESS=

# ─── the live-trading switch ───────────────────────────────────────────────

# NOT SET HERE. Deliberately.
#
# BOT_ALLOW_AUTOMATED_TRADES=1 is the third of three independent gates (the other
# two are mode.dryRun and mode.logOnly in config.json). It is read from the
# ENVIRONMENT ONLY so that it cannot be turned on by editing a file, and so a
# stray restart can never arm live trading on its own. Pass it on the command
# line, every time, on purpose:
#
#   BOT_ALLOW_AUTOMATED_TRADES=1 node --experimental-strip-types src/index.ts
#
# Without it the bot runs normally, records everything, and marks every entry
# paper. Note that GMGN_ALLOW_AUTOMATED_TRADES from the v1.0 era is deliberately
# NOT honoured — a variable still exported in an old shell must not arm a signer
# that did not exist when it was set.

# ─── optional ──────────────────────────────────────────────────────────────

# GMGN. DATA ONLY — it is not in the trading path. Kept for token security
# fields nothing else provides on this chain: top-10 holder concentration,
# sell tax, and whether the contract is open source.
GMGN_API_KEY=

# FOMO. Trader and wallet lookups, used to research which wallets to track.
# Not needed to run the bot.
FOMO_API_BASE=https://api.fomoapi.io
FOMO_API_KEY=

# Dashboard (tools/ui.ts). Defaults to 127.0.0.1:7777.
# UI_HOST must stay loopback unless UI_TOKEN is set — the dashboard refuses to
# bind a public interface unauthenticated.
UI_HOST=
UI_PORT=
UI_TOKEN=
