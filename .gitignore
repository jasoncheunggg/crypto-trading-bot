# secrets — never commit
.env
.env.*
!.env.example

# live trading state: positions, trade ledger, balances, price paths.
# Contains the wallet address and full trading history.
state/
*.log

# wallets.json IS committed as of 2026-09-12, at the operator's decision.
#
# It was excluded as "the strategy's alpha", and that reasoning still half applies — the
# curation is the work, even though the addresses themselves are public on FOMO's
# leaderboard. What is NOT published is our own results: the per-wallet live P&L and the
# backtest scores derived from replaying these wallets against our exit rules were stripped
# from the notes before publishing. Public FOMO data ABOUT the traders (follower counts,
# their volume, their holdings) is kept, because it is already public and it is the evidence
# for why each wallet is on the list.
#
# If you re-add research figures to these notes, strip them again before committing.

# backups and scratch
*.bak
*.bak-*
*.pre-*
sc_*.ts
sc_*.mjs

# local tooling config
.claude/

node_modules/
dist/

# local snapshots extracted from tags (git archive <tag>) — the tag IS the copy,
# this is just a browsable one. Committing it would duplicate the whole tree
# once per version.
versions/

# reference material for the operator and for Claude, not for publication.
# HANDOFF.md carries the wallet address and the live P&L; STATE.md and the prompt doc
# are working notes that go stale the moment they are written.
HANDOFF.md
STATE.md
copy-trading-bot-prompt.md
.DS_Store
