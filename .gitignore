# secrets — never commit
.env
.env.*
!.env.example

# live trading state: positions, trade ledger, balances, price paths.
# Contains the wallet address and full trading history.
state/
*.log

# the tracked KOL wallet list — this is the strategy's alpha.
# wallets.example.json IS committed, so the schema is documented without the real addresses.
wallets.json
!wallets.example.json

# backups and scratch
*.bak
sc_*.ts
sc_*.mjs

# local tooling config
.claude/

node_modules/
dist/

# local snapshots extracted from tags (git archive <tag>) — the tag IS the copy,
# this is just a browsable one. Committing it would duplicate the whole tree
# once per version.
versions/
